rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is the caller an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Is the caller the master admin or has admin role in database
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'muzaddidusama@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Helper: Is the user operating on their own document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      // Any authenticated user can read profiles (needed for member directory if approved/admin)
      allow read: if isAuthenticated();

      // New users can create their own initial profile as 'member' and 'approved: false'
      // (whitelisted admin email is allowed to bootstrap)
      allow create: if isOwner(userId) && (
        (request.resource.data.role == 'member' && request.resource.data.approved == false) ||
        request.auth.token.email.lower() == 'muzaddidusama@gmail.com'
      );

      // Members can only update their own watchlist/history/lastLogin without modifying role or approved status
      // Admins can update any user's role and approved status
      allow update: if (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'approved', 'uid', 'email'])
      ) || isAdmin();

      // Only admins can delete user records
      allow delete: if isAdmin();
    }

    // Global System Configuration (TMDB API key, platform flags)
    match /system/config {
      // Authenticated approved members can read global config
      allow read: if isAuthenticated() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true ||
        request.auth.token.email.lower() == 'muzaddidusama@gmail.com'
      );
      // Only admins can modify system settings
      allow write: if isAdmin();
    }
  }
}
